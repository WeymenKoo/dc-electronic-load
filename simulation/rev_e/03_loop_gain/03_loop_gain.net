X§U1 VSET N003 +12V 0 N004 TLV9152 ;§pnba In+)In-)V+)V-)OUT
C1 N004 N003 1n
Rb1 N003 +12V 15Meg
Dz1 N003 N004 BZX84C6V8
Rg1 G1 N004 47
M1 drain G1 src src FETSEL
Rs1 src 0 {Rs}
Rf1 inj N003 3.3k
Vset VSET 0 {Ich*Rs}
Vinj inj src AC 1
Rsn drain P001 2.2
Csn P001 0 2.2µ
Rlead N001 drain 20m
Llead N002 N001 {Llead}
Vdut N002 0 {Vdut}
V12 +12V 0 12
.model D D
.lib C:\users\crossover\AppData\Local\LTspice\lib\cmp\standard.dio
.model NMOS NMOS
.model PMOS PMOS
