TEXT -1256 -40 Left 1 ;LOAD_CTRL from MCP4725\n(control board, 0-4.096 V)
TEXT -1000 208 Left 1 ;V_SET = LOAD_CTRL / 16\n(0 - 0.256 V per channel)\nCset: 9.4 us slew filter
TEXT -840 368 Left 1 ;Sotp: LM339 #2 open-collector\nover-temp pull-down\n(Votp = 0 V: open)
TEXT -560 656 Left 1 ;Sdrop = LM339 #3 (open collector): holds KILL low while\nV(DRAIN) > 0.5 V.  DUT absent / collapsed -> KILL = 12 V ->\nDk/Rk lift every In- -> all gates to 0 V (no wind-up).\nDRAIN and KILL reach here by net label.
TEXT -192 -224 Left 3 ;CH1
TEXT -192 352 Left 3 ;CH2
TEXT -192 928 Left 3 ;CH3
TEXT -192 1504 Left 3 ;CH4
TEXT 1096 2272 Left 1 ;ISEN to STM32 ADC\n(1k + 10n, clamped\n to 3V3 by BAT54S)
TEXT 576 1952 Left 1 ;ISEN: AVG = mean of the 4 source voltages = I_total x Rs / 4\nV(ISEN) = 0.30 V/A + 0.12 V offset (3.19 V at 10.24 A)
TEXT 824 -488 Left 1 ;F1 15 A fast\n(5 mR)
TEXT 1056 -488 Left 1 ;DUT lead pair (+ side lumped)
TEXT 1392 -288 Left 1 ;DUT (PSU / battery under test)
TEXT 712 -216 Left 1 ;Snubber: damps\nlead L vs Coss
TEXT 1528 64 Left 1 ;VSEN to STM32 ADC\n(1k + 10n, clamped\n to 3V3 by BAT54S)
TEXT 1000 -208 Left 1 ;DUT- sense\n(= board GND at\nthe DUT- terminal)
TEXT 1000 160 Left 1 ;VSEN = 0.049 x (V(DUT+) - V(DUT-)) + 0.085 V\n3.0 V at 59 V, ADC clips at 65 V
TEXT -1256 560 Left 1 ;Rails from the control board\n(16-pin connector P1)
TEXT -1256 -400 Left 3 ;DC LOAD Rev E - ANALOG STAGE - 01 DC TRANSFER
TEXT -1256 -320 Left 1 ;Each channel: TLV9154 (1/4, TI model = TLV9152) forces V(Sn) = V_SET, so I_ch = V_SET / Rs  (Rs = 2 x 0.2R 2512 in parallel).\nDz (6.8 V) limits wind-up; Dk/Rk let the dropout detector force the op-amp low; Rb (15Meg) = +2.6 mV offset -> 0 A at V_SET = 0.\nRf/Cc = 3.3k/1n integrator, Rg = 47R.  I_total = 4 x V_SET / 0.1 = 2.5 A per volt of LOAD_CTRL (10.24 A full scale).
TEXT -1256 2400 Left 2 !.param fet=1 Rs=0.1 Vdut=12 Llead=1u\n.step param Vdut list 1 2 12 48\n.dc Vctrl 0 4.096 8m\n.meas DC Itot_FS FIND -I(Vdut) AT 4.096\n.meas DC Itot_1V FIND -I(Vdut) AT 1\n.meas DC gain_A_per_V PARAM (Itot_FS-Itot_1V)/3.096\n.meas DC Ich1_FS FIND Id(M1) AT 4.096\n.meas DC Ich4_FS FIND Id(M4) AT 4.096\n.meas DC ISEN_0 FIND V(ISEN_ADC) AT 0\n.meas DC ISEN_FS FIND V(ISEN_ADC) AT 4.096\n.meas DC ISEN_err_pct_FS PARAM 100*((ISEN_FS-ISEN_0)/(0.3*0.997506) - Itot_FS)/Itot_FS\n.meas DC VSEN FIND V(VSEN_ADC) AT 2\n.meas DC VDUTp FIND V(DUT+) AT 2\n.meas DC VSEN_ideal PARAM 1.05*(VDUTp*9791.67/209791.67 + 4.096*9523.8/479523.8)\n.meas DC VSEN_err_mV PARAM 1000*(VSEN-VSEN_ideal)\n.meas DC VSEN_err_pct_of_reading PARAM 100*(VSEN-VSEN_ideal)/(VSEN_ideal-0.08548)\n.meas DC Ploss_FS FIND V(DRAIN)*(-I(Vdut)) AT 4.096\n.include ../../lib/fet_models.lib\n.include ../../lib/tlv915x.lib\n.model SWOTP SW(Ron=2 Roff=1G Vt=1 Vh=0)    ; LM339 + 2N7002 pull-down\n.model SWDROP SW(Ron=50 Roff=1G Vt=0 Vh=50m) ; LM339 output, 50 mV hysteresis\n.include ../../lib/misc_models.lib
TEXT -1256 2160 Left 2 ;TEST: sweep LOAD_CTRL 0 -> 4.096 V at DUT = 1 / 2 / 12 / 48 V.\nEXPECT: 2.50 A/V, ~10.2 A full scale, channels equal; ISEN/VSEN errors vs their ideal (offset-\ncorrected) transfer < 0.5 %.  Ideal formulas are written out in the .meas lines.
