			)
			(justify left bottom)
		)
		(uuid "0a2a316a-0764-54c4-a347-8bd7e0be0d18")
	)
	(text "Control board + power board on one 2-layer panel, isolated, USB-C powered. 150 W, 0.6 - 58 V, 0 - 10.1 A. Hardware CC and CV, firmware CR / CP / battery. OLED + encoder UI, USB CDC / DFU, SCPI. JLCPCB / LCSC parts."
		(exclude_from_sim no)
		(at 18.0 26.5 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "376bfa72-7447-5431-ab52-ec06a12277dd")
	)
	(text "Each block is a sheet (page number under its name); every line is a wire between sheet pins, colour-coded by net class (key bottom left). Power rails are global symbols on the sheets."
		(exclude_from_sim no)
		(at 18.0 30.0 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "608c1bbb-a7b7-5e3b-b8e7-8318a6e18ebb")
	)
	(text "The analog stage is the Rev C design re-simulated with the TLV9154 (../simulation/rev_e); check_netlist_reve.py proves the netlist against deck 06."
		(exclude_from_sim no)
		(at 18.0 33.5 0)
		(effects
