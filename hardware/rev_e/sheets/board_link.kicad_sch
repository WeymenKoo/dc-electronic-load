	(text "Board link: control board J10 to power board J11 over a 12-way IDC ribbon cable"
		(exclude_from_sim no)
		(at 18.0 22.0 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 4.5 4.5)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "a3d3b566-dfb3-5070-a740-be632d5ca2c4")
	)
	(text "Two boards on one V-scored fabrication panel. Only USB-side digital and 5 V / 3.3 V power cross the cable; the isolation barrier stays on the power board."
		(exclude_from_sim no)
		(at 18.0 26.5 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "11d0e4d6-b912-57b5-8d6e-cbe901af4200")
	)
	(text "power flags: these three rails exist only through J11"
		(exclude_from_sim no)
		(at 265.65 119.21 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "df3be47d-717c-51a8-a2b4-ec663fbc7d88")
	)
	(text "Pins 1 2 VBUS   3 +3V3   4 SCK   5 MOSI   6 MISO   7 /CS_DAC   8 /CS_ADC   9 LOAD_OFF   10 11 12 DGND.\nThe two boards are separate nets in the PCB (no ratsnest across the V-score): J11-side nets carry the _LK\nsuffix and CBL1 is a BOM line only. The DC-DC and the isolator sit on the power board, so the cable carries\nnothing isolated and nothing analog; 2 MHz SPI over 80 mm of ribbon needs no termination. Keyed 2x6 box\nheaders (BOOMELE 2.54-2*6P, C9136, both vertical): J10 is hand-soldered on the BACK face of the control board\nso the ribbon leaves rearward, folds once and plugs into J11 from above on the power board. Check pin 1 to\npin 1 with a meter on the first pair; if the key makes that impossible, re-crimp one socket the other way."
		(exclude_from_sim no)
		(at 67.65 193.21 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "5a88c7fb-993c-5e3b-a8ec-dac048b1df08")
	)
	(text "A   J10 (control board, back face)  -  2x6 IDC ribbon  -  J11 (power board, USB-side island)"
		(exclude_from_sim no)
		(at 64.23 88.69 0)
		(effects
