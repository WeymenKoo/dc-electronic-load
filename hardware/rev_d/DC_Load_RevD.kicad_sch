	)
	(text "150 W, 0.6 - 58 V, 0 - 10.2 A. Hardware CC and CV, firmware CR / CP / battery. Local 7-segment UI, USB CDC / DFU, SCPI over USB."
		(exclude_from_sim no)
		(at 12 22.5 0)
		(effects
