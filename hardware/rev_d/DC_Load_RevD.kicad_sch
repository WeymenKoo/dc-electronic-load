	)
	(text "Reading order: USB & Power (2), MCU (3), Front Panel (4), Isolated Interface (5), Setpoint & CV (6), Channels (10-13), Sense (7), Protection (8), Power Path (9). Nets on this page join by name.\nPower symbols are global: VBUS, +3V3, +12V_FAN, DGND on the USB side; +12V_ISO, +5V_ISO, AGND, PGND on the analog side. The analog stage is the Rev C design verified in LTspice decks 01-06."
		(exclude_from_sim no)
		(at 16 286 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
