	(text "Protection: over-temperature, dropout / KILL, NTC-open, over-voltage, hardware OFF"
		(exclude_from_sim no)
		(at 12 18 0)
		(effects
			(font
				(face "Arial")
				(size 4.0 4.0)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "aa72c999-5af6-5c10-8ee1-8f75bab27b4e")
	)
	(text "LM339 open-collector comparators on +12V_ISO. Thresholds are ratios of +5V_ISO, the same rail that feeds the NTC divider."
		(exclude_from_sim no)
		(at 12 22.5 0)
		(effects
			(font
				(face "Arial")
				(size 1.8 1.8)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "f9c13ed3-d190-57d7-970b-cfc0740e5d1a")
	)
	(text "A   Heatsink NTC and TEMP_MON"
		(exclude_from_sim no)
		(at 16.5 33.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "88086053-7864-52db-9aae-e38c2bfad036")
	)
	(text "V_NTC (10k B3950 lug thermistor on the heatsink next to FET 2):\n2.50 V at 25 C, 1.52 V at 45 C, 0.75 V at 70 C, 0.49 V at 85 C.\nTEMP_MON goes to the ADC: the MCU runs the fan from it\n(on above 45 C, full above 65 C) and shows the temperature."
		(exclude_from_sim no)
		(at 18 153 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c372e350-96f6-5748-a85d-bcf255270179")
	)
	(text "B   Over-temperature: 85 C trip, 70 C release"
		(exclude_from_sim no)
		(at 121.5 33.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "66eb1d84-8117-5391-aaba-de41505fb3ba")
	)
	(text "In+ = 0.099 x rail (0.49 V = 85 C). Output high -> Q11 shorts V_SET.\nHysteresis via R55 from the 12 V output: releases at 0.75 V = 70 C."
		(exclude_from_sim no)
		(at 123 106 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b4816584-69ef-5fb4-8094-e20dc3de1a85")
	)
	(text "C   Dropout / anti-wind-up KILL: DRAIN below 0.45 V"
		(exclude_from_sim no)
		(at 271.5 33.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "68a7f168-ca63-5a43-97fb-2da855ace865")
	)
	(text "KILL pulls every channel In- high through 4.7k + 1N4148 when the DUT is\nabsent or below 0.45 V; releases above 0.54 V. Stops the 115 - 170 A\nrecovery spikes of deck 04. R60 sees 60 V: 1206."
		(exclude_from_sim no)
		(at 273 100 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2c8afcd5-9800-5ad3-be61-8a36aa832a8e")
	)
	(text "D   NTC open and hardware OFF: all roads to OFF_GATE"
		(exclude_from_sim no)
		(at 121.5 121.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "769bd753-75b3-55f4-b739-663ddc99d333")
	)
	(text "NTC open or unplugged: V_NTC above 0.73 x rail (= 3.66 V, NTC > 27 k) forces 0 A; an open NTC would\notherwise read as cold. False trip only below about 3 C. LOAD_OFF_ISO: the MCU-side OFF, 5 V logic through the\nisolator, asserted whenever the USB side is dead. OVP_OUT (block E) joins through D45. R65 defines the node\nwhen nothing drives it."
		(exclude_from_sim no)
		(at 123 211 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "f28472d5-d027-5da5-9f75-c9132c567003")
	)
	(text "E   Over-voltage: DUT above 62 V"
		(exclude_from_sim no)
		(at 271.5 121.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "065817c2-9b6e-5b31-9154-0e41d13a81ec")
	)
	(text "VSEN_OA above 0.629 x rail (3.15 V = 62 V at the terminals) forces 0 A through OFF_GATE.\nProtects the 58 V fuse rating and the 70 V TVS. R67 gives about 1.8 V of hysteresis.\nFirmware latches the trip; the comparator alone would re-arm when the DUT sags."
		(exclude_from_sim no)
		(at 273 211 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7a7979c9-35c8-5b34-9cae-13f4b2d2ed9d")
	)
	(text "F   Supplies of the analog ICs"
		(exclude_from_sim no)
		(at 16.5 161.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "be2e2731-17bf-529e-85de-0eb95cb8bd02")
	)
	(text "One 100 nF at every V+ pin, 10 uF bulk\nnear the LT1014."
		(exclude_from_sim no)
		(at 18 248 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e7605dba-9eb8-57d9-a1b6-13069eb242be")
	)
