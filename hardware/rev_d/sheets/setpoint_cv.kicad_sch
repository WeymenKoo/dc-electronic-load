	(text "Set-point and hardware CV: V_SET divider, protective pull-downs, CV error amplifier"
		(exclude_from_sim no)
		(at 18.0 22.0 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 4.5 4.5)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "c210b3e2-d04e-58be-ab89-63fe881477c1")
	)
	(text "V_SET = LOAD_CTRL / 16 is the only node the four channels follow. Anything that must stop the load pulls it to AGND."
		(exclude_from_sim no)
		(at 18.0 26.5 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "0d08dfdd-8ab9-5dc8-b4f7-f004127ed33e")
	)
	(text "R31 / R32 = 15 : 1, 0.1 %: 4.096 V in gives 256 mV = 2.56 A per channel. C33 slews the\nstep in 9 us so the loops never see a step edge. Q11 and Q12 are hardware and work with\nthe MCU dead. CV (block B) pulls this node down too, so LOAD_CTRL stays the ceiling in CV."
		(exclude_from_sim no)
		(at 81.15 116.51 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "4b35368b-2764-5ef5-b36c-9e20582c4d41")
	)
	(text "A   V_SET: 0 - 256 mV = 0 - 10.24 A"
		(exclude_from_sim no)
		(at 71.85 65.83 0)
		(effects
			(font
