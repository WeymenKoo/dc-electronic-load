	(text "Set-point and hardware CV: V_SET divider, protective pull-downs, CV error amplifier"
		(exclude_from_sim no)
		(at 12 18 0)
		(effects
			(font
				(face "Arial")
				(size 4.0 4.0)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "cdb5374b-832a-5e7d-b30b-10b9893744e6")
	)
	(text "V_SET = LOAD_CTRL / 16 is the only node the four channels follow. Anything that must stop the load pulls it to AGND."
		(exclude_from_sim no)
		(at 12 22.5 0)
		(effects
			(font
				(face "Arial")
				(size 1.8 1.8)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "6075b72c-6c99-5183-a657-2496511cc03d")
	)
	(text "A   V_SET: 0 - 256 mV = 0 - 10.24 A"
		(exclude_from_sim no)
		(at 16.5 33.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "accd2d24-5012-55e2-b598-8ba9280d9cfd")
	)
	(text "R31 / R32 = 15 : 1, 0.1 %: 4.096 V in gives 256 mV = 2.56 A per channel. C33 slews the step in 9 us so the loops never see a step edge.\nQ11 and Q12 are hardware. They work with the MCU dead. CV (block B) pulls this node down too, so LOAD_CTRL is the ceiling in CV."
		(exclude_from_sim no)
		(at 18 93 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "0f9bfeeb-f493-5f59-a075-b6055d572ee8")
	)
	(text "B   Hardware constant-voltage loop (LTspice deck 06)"
		(exclude_from_sim no)
		(at 16.5 103.4 0)
