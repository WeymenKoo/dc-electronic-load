	)
	(text "74AHCT125: TTL input thresholds, 5 V output. The spare gate is parked\n(input and /OE low). ISET 33k: 16 mA peak per segment at 1/8 duty;\nthe intensity register trims it further."
		(exclude_from_sim no)
		(at 40.51 208.54 0)
		(effects
