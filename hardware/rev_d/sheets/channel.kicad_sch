	(text "Current-sink channel (4 instances, one LT1014 section each)"
		(exclude_from_sim no)
		(at 12 18 0)
		(effects
			(font
				(face "Arial")
				(size 4.0 4.0)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "6bb353ca-c4ec-5633-bac8-fc838aeb13ec")
	)
	(text "Each MOSFET gets its own loop forced to V_SET / 0.1 R, so current and power share equally whatever the threshold spread."
		(exclude_from_sim no)
		(at 12 22.5 0)
		(effects
			(font
				(face "Arial")
				(size 1.8 1.8)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "0da28a6a-e1d9-549c-ab12-c969b7358cde")
	)
	(text "Channel (one of four): LT1014 section, 3.3k / 1n / 47R compensation, IRFP250N, 2 x 0.2R Kelvin sense"
		(exclude_from_sim no)
		(at 16.5 33.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "95a5979a-8ee8-5e86-8ad5-38d335075cfc")
	)
	(text "Rs: two 0.2 R 2512 in parallel = 0.1 R, so I_ch = V_SET / 0.1 R (2.56 A full scale).\nKELVIN: Rn03 and Rn08 connect at the TOP PAD of the Rs pair on their own trace, never along the high-current source copper.\nRg within 10 mm of the gate pin. Dn03 and Rn05 sit at the FET pins. Dn02 limits integrator wind-up; Rn02 gives +1.8 mV offset\nso DAC code 0 is truly 0 A (dead zone about 72 mA in total). Loop values from deck 03: PM >= 80 deg, GM >= 13 dB for every FET candidate.\nChange them only with a re-run of deck 03.  (n = channel number)"
		(exclude_from_sim no)
		(at 18 170 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "c66ace85-e7a5-543f-9a7a-ae21393546e3")
	)
