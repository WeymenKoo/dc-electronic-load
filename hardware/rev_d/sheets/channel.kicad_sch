	(text "Current-sink channel (4 instances, one LT1014 section each)"
		(exclude_from_sim no)
		(at 18.0 22.0 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 4.5 4.5)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "32158451-c5e2-5dc9-8645-315c28ca02c0")
	)
	(text "Each MOSFET gets its own loop forced to V_SET / 0.1 R, so current and power share equally whatever the threshold spread."
		(exclude_from_sim no)
		(at 18.0 26.5 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "78f5af24-5130-5a90-a056-30de63cd6cfb")
	)
	(text "Rs: two 0.2 R 2512 in parallel = 0.1 R, so I_ch = V_SET / 0.1 R (2.56 A full scale).\nKELVIN: Rn03 and Rn08 connect at the TOP PAD of the Rs pair on their own trace, never\nalong the high-current source copper. Rg within 10 mm of the gate pin. Dn03 and Rn05 sit\nat the FET pins. Dn02 limits integrator wind-up; Rn02 gives +1.8 mV offset so DAC code 0\nis truly 0 A (dead zone about 72 mA in total). Loop values from deck 03: PM >= 80 deg,\nGM >= 13 dB for every FET candidate. Change them only with a re-run of deck 03.\n(n = channel number)"
		(exclude_from_sim no)
		(at 109.09 210.45 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "23ac3355-aed4-50f5-9884-bc93a425c926")
	)
	(text "Channel (one of four): LT1014 section, 3.3k / 1n / 47R compensation, IRFP250N, 2 x 0.2R Kelvin sense"
		(exclude_from_sim no)
		(at 104.87 72.18 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.5 2.5)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "4075f33b-108f-5ff4-8b36-6e30fb4fe157")
	)
