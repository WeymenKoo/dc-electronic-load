	(text "Isolated interface: digital isolator, set-point DAC, readback ADC"
		(exclude_from_sim no)
		(at 18.0 22.0 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 4.5 4.5)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "007de9bc-5ebe-5403-97bd-413316c837d0")
	)
	(text "SPI crosses the barrier. The DAC and ADC carry their own references, so no precision reference or trimmer is needed."
		(exclude_from_sim no)
		(at 18.0 26.5 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "293094d7-3fe5-5463-bad7-e841191e0fd9")
	)
	(text "ISOLATION BARRIER"
		(exclude_from_sim no)
		(at 113.62 89.94 90)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(bold yes)
				(color 200 0 0 1)
			)
			(justify left bottom)
		)
		(uuid "3c49fac8-a593-57f0-b149-8d911107da45")
	)
	(text "Side 1 = MCU (3.3 V), side 2 = analog (5 V). Five channels go to the\nanalog side, MISO comes back. ISO7761 (no F suffix) outputs default HIGH\nwhen side 1 is unpowered or an input floats: chip selects stay\nde-asserted and LOAD_OFF_ISO is asserted, so the load is OFF until\nfirmware says otherwise. R21-R23 give the same guarantee while the MCU\nis in reset. Propagation delay 11 ns: SPI at 2 MHz or less."
		(exclude_from_sim no)
		(at 57.02 173.94 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "4fffc62f-bfc0-5689-9ee0-1e96d318779d")
	)
	(text "A   Digital isolator"
		(exclude_from_sim no)
		(at 50.26 55.67 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.5 2.5)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "00462a73-cb37-5d18-944f-9a88e279d93d")
	)
	(text "12 bit, internal 2.048 V reference, gain 2: 0 - 4.095 V in 1 mV steps.\nA: LOAD_CTRL, 2.5 A per volt = 2.44 mA per LSB. B: CV_SET in VSEN volts.\nBoth outputs are 0 V after power-up (POR shutdown): no EEPROM surprise\nlike the MCP4725."
		(exclude_from_sim no)
		(at 245.02 131.94 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "c6ab2c60-169c-5326-8093-c4b923b14dca")
	)
	(text "B   Set-point DAC: A = current ceiling, B = CV voltage"
		(exclude_from_sim no)
		(at 240.76 58.21 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.5 2.5)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "c86acd11-6d12-520f-9cb4-1b8fda496a76")
	)
