	(text "Sense: ISEN = mean of the four source nodes, VSEN = true 4-wire difference amplifier"
		(exclude_from_sim no)
		(at 18.0 22.0 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 4.5 4.5)
				(bold yes)
				(color 0 40 90 1)
			)
			(justify left bottom)
		)
		(uuid "217632a2-c48d-57b7-b2fe-50ad4546805e")
	)
	(text "Both outputs are scaled for the 4.096 V ADC range and clamped to +5V_ISO. Offsets are deliberate and calibrated out in firmware."
		(exclude_from_sim no)
		(at 18.0 26.5 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(italic yes)
				(color 70 70 70 1)
			)
			(justify left bottom)
		)
		(uuid "2523a0c7-3f5a-59fe-9344-ee913eb44cf9")
	)
	(text "Gain 12 (R43 / R42 + 1). R41 injects +12 mV at the input (= +0.15 V out) so the amp\nnever sits on its 35 mV output floor. Full scale 3.22 V at 10.24 A, 0.4 mA per ADS1118\nLSB. U13 is the S8 package: NON-STANDARD pinout, the symbol is correct for it."
		(exclude_from_sim no)
		(at 131.95 131.94 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "60f4e284-2dda-5759-a986-664c08009104")
	)
	(text "A   ISEN: 0.300 V/A + 0.15 V"
		(exclude_from_sim no)
		(at 127.73 55.67 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.5 2.5)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "1b13e6f9-8245-5d63-aaf3-6d9311e01738")
	)
	(text "VSEN = 0.049 x (SENSE_P - SENSE_N) + 0.10 V: 2.5 mV of DUT per LSB, clips at 65 V.\nR45 and R48 see 60 V: 1206. R49 feeds back to -IN (the Rev B board had it on +IN and\nlatched). VSEN_OA also feeds the CV loop and the OVP comparator."
		(exclude_from_sim no)
		(at 131.95 225.94 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.0 2.0)
				(color 40 40 40 1)
			)
			(justify left bottom)
		)
		(uuid "d4e1e965-4715-5e5d-9dc5-990f19c0af59")
	)
	(text "B   VSEN: 0.049 V/V + 0.10 V, true 4-wire"
		(exclude_from_sim no)
		(at 126.46 145.84 0)
		(effects
			(font
				(face "JetBrains Mono")
				(size 2.5 2.5)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "54f18cb3-fa13-54e2-9ca2-2db0c26007b7")
	)
