		)
		(uuid "3352cf25-1fe2-5392-a7e6-a2ce5a00b539")
	)
	(text "A   Terminals and DRAIN bus"
		(exclude_from_sim no)
		(at 16.5 33.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "bc9911c9-9c79-542a-965a-d0c5446bad6d")
	)
	(text "Fuse: the 58 V DC MINI part named. Ordinary blade fuses are rated 32 V, so 58 V is the DUT limit of this board (OVP trips at 62 V).\nNo series diode, so the load works down to 0.6 V. Reverse polarity conducts through the FET body diodes and the TVS and clears the fuse."
		(exclude_from_sim no)
		(at 18 108.5 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "b50ed3c8-88b9-5783-8819-5d586df80285")
	)
	(text "B   4-wire sense with local fallback"
		(exclude_from_sim no)
		(at 16.5 119.4 0)
		(effects
			(font
				(face "Arial")
				(size 2.2 2.2)
				(bold yes)
				(color 0 50 120 1)
			)
			(justify left bottom)
		)
		(uuid "f5a4337d-e91a-58a8-bf71-423293f3bb47")
	)
	(text "J9 open: R72 / R73 connect the sense amplifier to the terminals. J9 wired to the DUT: they carry only microamps and the lead drop\nleaves the reading. A miswired sense lead burns a 100 R 1206 open and nothing else.\nCopper: >= 5 mm of 2 oz for DUT+ / DRAIN / PGND, or a soldered wire. C58 and D51 directly across DRAIN / PGND at the terminals."
		(exclude_from_sim no)
		(at 120 168 0)
		(effects
			(font
				(face "Arial")
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "9fa4969c-f93c-5602-b773-499e8b554a89")
	)
